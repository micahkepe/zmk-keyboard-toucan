#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/mouse.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define ADJ  3

/ {
    behaviors {
        hm: homerow_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    // https://github.com/zmkfirmware/zmk/blob/main/app/include/dt-bindings/zmk/keys.h
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "HOME";
            bindings = <
//    ┌──────┬────────────┬────────────┬────────────┬────────────┬──────┐   ┌─────┬────────────┬────────────┬────────────┬────────────┬──────┐
//    │ tab  │     Q      │     W      │     E      │     R      │  T   │   │  Y  │     U      │     I      │     O      │     P      │ bspc │
//    ├──────┼────────────┼────────────┼────────────┼────────────┼──────┤   ├─────┼────────────┼────────────┼────────────┼────────────┼──────┤
//    │ caps │ &hm lctl A │ &hm lalt S │ &hm lgui D │ &hm lsft F │  G   │   │  H  │ &hm rsft J │ &hm rgui K │ &hm ralt L │ &hm rctl ; │  '   │
//    ├──────┼────────────┼────────────┼────────────┼────────────┼──────┤   ├─────┼────────────┼────────────┼────────────┼────────────┼──────┤
//    │ lsft │     Z      │     X      │     C      │     V      │  B   │   │  N  │     M      │     ,      │     .      │     /      │      │
//    └──────┴────────────┴────────────┼────────────┼────────────┼──────┤   ├─────┼────────────┼────────────┼────────────┴────────────┴──────┘
//                                     │    lgui    │    spc     │ mo 1 │   │ ent │    mo 2    │    ralt    │
//                                     └────────────┴────────────┴──────┘   └─────┴────────────┴────────────┘
  &kp TAB        &kp Q         &kp W        &kp E            &kp R          &kp T       &kp Y     &kp U          &kp I        &kp O        &kp P            &kp BSPC
  &kp CAPSLOCK   &hm LCTRL A   &hm LALT S   &hm LEFT_GUI D   &hm LSHIFT F   &kp G       &kp H     &hm RSHIFT J   &hm RGUI K   &hm RALT L   &hm RCTRL SEMI   &kp SQT
  &kp LSHIFT     &kp Z         &kp X        &kp C            &kp V          &kp B       &kp N     &kp M          &kp COMMA    &kp DOT      &kp FSLH         &trans
                                            &kp LGUI         &kp SPACE      &mo 1       &kp RET   &mo 2          &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
//    ┌─────┬───┬───┬──────┬─────┬─────┐   ┌─────┬─────┬──────┬───┬───┬──────┐
//    │     │ ! │ @ │  #   │  $  │  %  │   │  ^  │  &  │  *   │ ( │ ) │ bspc │
//    ├─────┼───┼───┼──────┼─────┼─────┤   ├─────┼─────┼──────┼───┼───┼──────┤
//    │     │ 1 │ 2 │  3   │  4  │  5  │   │  -  │  =  │  [   │ ] │ \ │  `   │
//    ├─────┼───┼───┼──────┼─────┼─────┤   ├─────┼─────┼──────┼───┼───┼──────┤
//    │     │ 6 │ 7 │  8   │  9  │  0  │   │  _  │  +  │  {   │ } │ | │  ~   │
//    └─────┴───┴───┼──────┼─────┼─────┤   ├─────┼─────┼──────┼───┴───┴──────┘
//                  │ lgui │ spc │     │   │ ent │     │ ralt │
//                  └──────┴─────┴─────┘   └─────┴─────┴──────┘
  &trans   &kp EXCL   &kp AT   &kp HASH   &kp DLLR    &kp PRCNT       &kp CARET   &kp AMPS    &kp STAR   &kp LPAR   &kp RPAR   &kp BSPC
  &trans   &kp N1     &kp N2   &kp N3     &kp N4      &kp N5          &kp MINUS   &kp EQUAL   &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
  &trans   &kp N6     &kp N7   &kp N8     &kp N9      &kp N0          &kp UNDER   &kp PLUS    &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
                               &kp LGUI   &kp SPACE   &trans          &kp RET     &trans      &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
//    ┌─────┬────────────────┬──────┬──────┬──────┬──────┐   ┌────────────────┬────────────────┬──────────────┬────────────────┬─────┬─────┐
//    │ f1  │       f2       │  f3  │  f4  │  f5  │  f6  │   │       f7       │       f8       │      f9      │      f10       │ f11 │ f12 │
//    ├─────┼────────────────┼──────┼──────┼──────┼──────┤   ├────────────────┼────────────────┼──────────────┼────────────────┼─────┼─────┤
//    │     │      prev      │ next │ vold │ volu │ play │   │      left      │      down      │      up      │      rght      │     │     │
//    ├─────┼────────────────┼──────┼──────┼──────┼──────┤   ├────────────────┼────────────────┼──────────────┼────────────────┼─────┼─────┤
//    │     │ &studio_unlock │ mute │ bri- │ bri+ │ lclk │   │ &mmv MOVE_left │ &mmv MOVE_down │ &mmv MOVE_up │ &mmv MOVE_rght │     │     │
//    └─────┴────────────────┴──────┼──────┼──────┼──────┤   ├────────────────┼────────────────┼──────────────┼────────────────┴─────┴─────┘
//                                  │ lgui │ spc  │ mo 3 │   │      ent       │                │     ralt     │
//                                  └──────┴──────┴──────┘   └────────────────┴────────────────┴──────────────┘
  &kp F1   &kp F2           &kp F3       &kp F4         &kp F5         &kp F6          &kp F7           &kp F8           &kp F9         &kp F10           &kp F11   &kp F12
  &trans   &kp C_PREV       &kp C_NEXT   &kp C_VOL_DN   &kp C_VOL_UP   &kp C_PP        &kp LEFT         &kp DOWN         &kp UP         &kp RIGHT         &none     &none
  &trans   &studio_unlock   &kp C_MUTE   &kp C_BRI_DN   &kp C_BRI_UP   &mkp LCLK       &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &none     &none
                                         &kp LGUI       &kp SPACE      &mo 3           &kp RET          &trans           &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
//    ┌────────┬──────────┬──────────┬──────────┬──────────┬──────────┐   ┌─────┬──────┬──────┬─────┬─────┬─────┐
//    │        │          │          │          │          │          │   │     │      │      │     │     │     │
//    ├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├─────┼──────┼──────┼─────┼─────┼─────┤
//    │ bt_clr │ bt_sel 0 │ bt_sel 1 │ bt_sel 2 │ bt_sel 3 │ bt_sel 4 │   │     │      │      │     │     │     │
//    ├────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├─────┼──────┼──────┼─────┼─────┼─────┤
//    │        │          │          │          │          │          │   │     │      │      │     │     │     │
//    └────────┴──────────┴──────────┼──────────┼──────────┼──────────┤   ├─────┼──────┼──────┼─────┴─────┴─────┘
//                                   │   lgui   │  mo NAV  │   spc    │   │ ent │ mo 2 │ ralt │
//                                   └──────────┴──────────┴──────────┘   └─────┴──────┴──────┘
  &none        &none          &none          &none          &none          &none              &none     &none   &none      &none   &none   &none
  &bt BT_CLR   &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4       &none     &none   &none      &none   &none   &none
  &none        &none          &none          &none          &none          &none              &none     &none   &none      &none   &none   &none
                                             &kp LGUI       &mo NAV        &kp SPACE          &kp RET   &mo 2   &kp RALT
            >;
        };

        // Define extra layers here.
    };
};
