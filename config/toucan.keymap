#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Mouse movement overrides — must be before mouse/pointing includes.
// See: <https://zmk.dev/docs/keymaps/behaviors/mouse-emulation#mouse-emulation-defines>.
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default 10
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define ADJ  3

/ {
    behaviors {
        // https://github.com/urob/zmk-config#timeless-homerow-mods
        // Hold triggers only from opposite-hand keys + thumbs.
        // Same-hand rolls always tap.
        hml: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };
        hmr: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    // https://github.com/zmkfirmware/zmk/blob/main/app/include/dt-bindings/zmk/keys.h
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
//    ┌──────┬─────────────┬─────────────┬─────────────┬─────────────┬──────┐   ┌─────┬─────────────┬─────────────┬─────────────┬─────────────┬──────┐
//    │ tab  │      Q      │      W      │      E      │      R      │  T   │   │  Y  │      U      │      I      │      O      │      P      │ bspc │
//    ├──────┼─────────────┼─────────────┼─────────────┼─────────────┼──────┤   ├─────┼─────────────┼─────────────┼─────────────┼─────────────┼──────┤
//    │ caps │ &hml lctl A │ &hml lalt S │ &hml lgui D │ &hml lsft F │  G   │   │  H  │ &hmr rsft J │ &hmr rgui K │ &hmr ralt L │ &hmr rctl ; │  '   │
//    ├──────┼─────────────┼─────────────┼─────────────┼─────────────┼──────┤   ├─────┼─────────────┼─────────────┼─────────────┼─────────────┼──────┤
//    │ lsft │      Z      │      X      │      C      │      V      │  B   │   │  N  │      M      │      ,      │      .      │      /      │      │
//    └──────┴─────────────┴─────────────┼─────────────┼─────────────┼──────┤   ├─────┼─────────────┼─────────────┼─────────────┴─────────────┴──────┘
//                                       │    lgui     │     spc     │ mo 1 │   │ ent │  lt 2 esc   │    ralt     │
//                                       └─────────────┴─────────────┴──────┘   └─────┴─────────────┴─────────────┘
  &kp TAB        &kp Q          &kp W         &kp E             &kp R           &kp T       &kp Y     &kp U           &kp I         &kp O         &kp P             &kp BSPC
  &kp CAPSLOCK   &hml LCTRL A   &hml LALT S   &hml LEFT_GUI D   &hml LSHIFT F   &kp G       &kp H     &hmr RSHIFT J   &hmr RGUI K   &hmr RALT L   &hmr RCTRL SEMI   &kp SQT
  &kp LSHIFT     &kp Z          &kp X         &kp C             &kp V           &kp B       &kp N     &kp M           &kp COMMA     &kp DOT       &kp FSLH          &trans
                                              &kp LGUI          &kp SPACE       &mo 1       &kp RET   &lt 2 ESC       &kp RALT
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
//    ┌─────┬───┬───┬─────┬─────┬─────┐   ┌─────┬─────┬──────┬───┬───┬──────┐
//    │     │ ! │ @ │  #  │  $  │  %  │   │  ^  │  &  │  *   │ ( │ ) │ bspc │
//    ├─────┼───┼───┼─────┼─────┼─────┤   ├─────┼─────┼──────┼───┼───┼──────┤
//    │     │ 1 │ 2 │  3  │  4  │  5  │   │  -  │  =  │  [   │ ] │ \ │  `   │
//    ├─────┼───┼───┼─────┼─────┼─────┤   ├─────┼─────┼──────┼───┼───┼──────┤
//    │     │ 6 │ 7 │  8  │  9  │  0  │   │  _  │  +  │  {   │ } │ | │  ~   │
//    └─────┴───┴───┼─────┼─────┼─────┤   ├─────┼─────┼──────┼───┴───┴──────┘
//                  │     │     │     │   │ ent │ spc │ ralt │
//                  └─────┴─────┴─────┘   └─────┴─────┴──────┘
  &trans   &kp EXCL   &kp AT   &kp HASH   &kp DLLR   &kp PRCNT       &kp CARET   &kp AMPS    &kp STAR   &kp LPAR   &kp RPAR   &kp BSPC
  &trans   &kp N1     &kp N2   &kp N3     &kp N4     &kp N5          &kp MINUS   &kp EQUAL   &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
  &trans   &kp N6     &kp N7   &kp N8     &kp N9     &kp N0          &kp UNDER   &kp PLUS    &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
                               &none      &none      &trans          &kp RET     &kp SPACE   &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
//    ┌─────┬────────────────┬──────┬──────┬──────┬──────┐   ┌────────────────┬────────────────┬──────────────┬────────────────┬─────┬─────┐
//    │ f1  │       f2       │  f3  │  f4  │  f5  │  f6  │   │       f7       │       f8       │      f9      │      f10       │ f11 │ f12 │
//    ├─────┼────────────────┼──────┼──────┼──────┼──────┤   ├────────────────┼────────────────┼──────────────┼────────────────┼─────┼─────┤
//    │     │      prev      │ next │ vold │ volu │ play │   │      left      │      down      │      up      │      rght      │     │     │
//    ├─────┼────────────────┼──────┼──────┼──────┼──────┤   ├────────────────┼────────────────┼──────────────┼────────────────┼─────┼─────┤
//    │     │ &studio_unlock │ mute │ bri- │ bri+ │ lclk │   │ &mmv MOVE_left │ &mmv MOVE_down │ &mmv MOVE_up │ &mmv MOVE_rght │     │     │
//    └─────┴────────────────┴──────┼──────┼──────┼──────┤   ├────────────────┼────────────────┼──────────────┼────────────────┴─────┴─────┘
//                                  │ lgui │ spc  │      │   │      ent       │                │     ralt     │
//                                  └──────┴──────┴──────┘   └────────────────┴────────────────┴──────────────┘
  &kp F1   &kp F2           &kp F3       &kp F4         &kp F5         &kp F6          &kp F7           &kp F8           &kp F9         &kp F10           &kp F11   &kp F12
  &trans   &kp C_PREV       &kp C_NEXT   &kp C_VOL_DN   &kp C_VOL_UP   &kp C_PP        &kp LEFT         &kp DOWN         &kp UP         &kp RIGHT         &none     &none
  &trans   &studio_unlock   &kp C_MUTE   &kp C_BRI_DN   &kp C_BRI_UP   &mkp LCLK       &mmv MOVE_LEFT   &mmv MOVE_DOWN   &mmv MOVE_UP   &mmv MOVE_RIGHT   &none     &none
                                         &kp LGUI       &kp SPACE      &trans          &kp RET          &trans           &kp RALT
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
//    ┌────────┬────────────┬──────────┬──────────┬──────────┬──────────┐   ┌─────┬─────┬─────┬─────┬────────────┬──────┐
//    │        │            │          │          │          │          │   │     │     │     │     │            │      │
//    ├────────┼────────────┼──────────┼──────────┼──────────┼──────────┤   ├─────┼─────┼─────┼─────┼────────────┼──────┤
//    │ bt_clr │  bt_sel 0  │ bt_sel 1 │ bt_sel 2 │ bt_sel 3 │ bt_sel 4 │   │     │     │     │     │            │      │
//    ├────────┼────────────┼──────────┼──────────┼──────────┼──────────┤   ├─────┼─────┼─────┼─────┼────────────┼──────┤
//    │  boot  │ &sys_reset │          │          │          │          │   │     │     │     │     │ &sys_reset │ boot │
//    └────────┴────────────┴──────────┼──────────┼──────────┼──────────┤   ├─────┼─────┼─────┼─────┴────────────┴──────┘
//                                     │          │          │          │   │     │     │     │
//                                     └──────────┴──────────┴──────────┘   └─────┴─────┴─────┘
  &none         &none          &none          &none          &none          &none              &none   &none   &none   &none   &none        &none
  &bt BT_CLR    &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4       &none   &none   &none   &none   &none        &none
  &bootloader   &sys_reset     &none          &none          &none          &none              &none   &none   &none   &none   &sys_reset   &bootloader
                                              &none          &none          &none              &none   &none   &none
            >;
        };

        // Define extra layers here.
    };
};
